<Window x:Class="DayZAI.Desktop.SteamWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="DayZ AI — Steam Manager" Width="700" Height="570" MinWidth="650" MinHeight="510" Background="#101820" Foreground="White" WindowStartupLocation="CenterOwner">
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="24">
      <TextBlock Text="Steam Manager" FontSize="28" FontWeight="Bold"/>
      <TextBlock Name="Target" TextWrapping="Wrap" Margin="0,8,0,12"/>
      <TextBlock Text="SteamCMD (официальный клиент Valve)"/>
      <DockPanel Margin="0,6,0,8">
        <Button DockPanel.Dock="Right" Content="Выбрать EXE" Click="Choose_Click" Padding="12,8" Margin="8,0,0,0"/>
        <TextBox Name="SteamPath" IsReadOnly="True" Padding="6"/>
      </DockPanel>
      <Button Content="Скачать SteamCMD с сайта Valve" Click="DownloadLink_Click" HorizontalAlignment="Left" Padding="10,6"/>
      <TextBlock Text="Имя учётной записи Steam (не пароль)" Margin="0,12,0,4"/>
      <TextBox Name="Account" MaxLength="64" Padding="6"/>
      <TextBlock Text="Пароль и Steam Guard вводятся только в окне SteamCMD. DayZ AI их не запрашивает и не хранит. Steam проверяет доступ к контенту при загрузке." TextWrapping="Wrap" Margin="0,8,0,12"/>
      <Button Name="ServerButton" Content="Установить / обновить сервер" Click="Server_Click" Padding="12,10"/>
      <TextBlock Text="Workshop ID (число из ссылки на мод)" Margin="0,14,0,4"/>
      <TextBox Name="WorkshopId" MaxLength="20" Padding="6"/>
      <WrapPanel Margin="0,8,0,8">
        <Button Name="DownloadButton" Content="Скачать мод" Click="Workshop_Click" Padding="12,10" Margin="0,0,8,4"/>
        <Button Name="InstallButton" Content="Установить скачанный мод" Click="Install_Click" Padding="12,10" Margin="0,0,0,4"/>
      </WrapPanel>
      <TextBlock Text="Перед обслуживанием остановите сервер. Существующие папки модов не заменяются. Скопируйте конфигурации перед обновлением сервера." TextWrapping="Wrap" Foreground="#F0C674"/>
      <TextBlock Name="Result" TextWrapping="Wrap" Margin="0,12,0,0"/>
    </StackPanel>
  </ScrollViewer>
</Window>
